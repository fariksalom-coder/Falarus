{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    { "path": "/api/cron/click-auto-pay", "schedule": "15 * * * *" },
    { "path": "/api/cron/click-fiscal-retry", "schedule": "45 * * * *" }
  ],
  "redirects": [
    { "source": "/pricing", "destination": "/tariflar", "permanent": true },
    { "source": "/auth", "destination": "/login", "permanent": true }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/api/activity/streak", "destination": "/api/streak" },
    { "source": "/api/admin/payments/:id/:action", "destination": "/api/admin/users?path=payments/:id/:action" },
    { "source": "/api/admin/help/chats", "destination": "/api/admin/users?path=help/chats" },
    { "source": "/api/admin/help/chats/:chatId/messages", "destination": "/api/admin/users?path=help/chats/:chatId/messages" },
    { "source": "/api/admin/help/chats/:chatId/media", "destination": "/api/admin/users?path=help/chats/:chatId/media" },
    { "source": "/api/admin/help/chats/:chatId/read", "destination": "/api/admin/users?path=help/chats/:chatId/read" },
    {
      "source": "/((?!api/)(?!icons/)(?!lesson-19/)(?!assets/)(?!.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
