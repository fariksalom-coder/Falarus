# Supabase (required for API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: for Supabase CLI (npm run db:push). Either:
# SUPABASE_DB_PASSWORD=...   (and optionally SUPABASE_POOLER_REGION=eu-west-1 etc.)
# or paste the full URI from Dashboard → Database → Connection string:
# SUPABASE_DB_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Optional: custom JWT secret for app auth (defaults to a dev value)
JWT_SECRET="your-secret"

# App timezone for statistics aggregation and daily limits.
APP_TIMEZONE="Asia/Tashkent"

# Admin panel: create first admin with npm run seed:admin (uses same JWT_SECRET)
# ADMIN_EMAIL=admin@falarus.uz
# ADMIN_PASSWORD=your-secure-password

# GEMINI_API_KEY: Optional, for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: Backend API URL. Leave empty when running locally (npm run dev) = local backend + local DB.
# Production on YOUR OWN server (VPS): leave empty if frontend and API same origin (nginx отдаёт и SPA и /api).
# If frontend elsewhere — укажите полный URL API, например https://www.example.com
# On Vercel-only frontend: set to your backend URL (e.g. https://falarus.uz).
#
# Same data as online (one account everywhere):
#   Run:  npm run dev:prod
#   This uses https://falarus.uz as API, so localhost shows the same progress as falarus.uz for the same login.
VITE_API_URL=""

# Public legal footer & huquqiy sahifalar (frontend build — VITE_*). VPS/Vercel da prod uchun to‘ldiring.
# VITE_LEGAL_OWNER_NAME="Familiya Ism Otachevich"
# VITE_LEGAL_INN="123456789"
# VITE_LEGAL_SUPPORT_EMAIL="support@falarus.uz"
# VITE_LEGAL_SUPPORT_PHONE="+998901234567"

# Optional: public base URL for course media (audio/video/images) when files are NOT in Git — e.g. Supabase Storage
# or Cloudflare R2 / any CDN with the same paths as `public/courses/` (URLs stay `/courses/...` in code).
# Example Supabase: VITE_COURSE_MEDIA_BASE_URL="https://YOUR_PROJECT.supabase.co/storage/v1/object/public/course-assets"
# Example R2:        VITE_COURSE_MEDIA_BASE_URL="https://pub-xxxxx.r2.dev"  (must mirror /courses/... layout)
# VITE_COURSE_MEDIA_BASE_URL=""
#
# Production build (Vercel): committed `.env.production` is loaded by `vite build` (see also Vercel env overrides).
#
# Upload to Supabase: npm run upload:course-media (needs SUPABASE_SERVICE_ROLE_KEY). Free plan: max 50 MB per file —
# run npm run compress:course-mp4 first if you have larger .mp4. Pro plan: raise Storage global file size limit in Dashboard.
# Optional: COURSE_MEDIA_BUCKET=course-assets

# Optional: Redis URL for vocabulary progress cache (5 min TTL). If not set, cache is skipped.
# REDIS_URL="redis://localhost:6379"

# Optional: base URL for referral links (default: https://www.falarus.uz)
# REFERRAL_BASE_URL="https://www.falarus.uz"

# Optional: Click payment gateway (UZS only).
#
# === Реальный тест оплат (по рекомендации Click: малые суммы, потом отмена через поддержку) ===
# 1) Заполните переменные ниже и выполните: npm run click:preflight -- https://ВАШ_ПУБЛИЧНЫЙ_ДОМЕН
# 2) В кабинете Click укажите колбеки (POST), без пробелов и совпадая с доменом продакшена:
#      https://ВАШ_ДОМЕН/api/click/prepare
#      https://ВАШ_ДОМЕН/api/click/complete
# 3) Cron (автопродление подписки + повтор фискализации):
#    • Vercel: CRON_SECRET в Env; расписание в vercel.json.
#    • Свой сервер (VPS, например IP вроде 82.x.x.x с доменом в DNS): vercel.json НЕ используется — добавьте в crontab
#      на ЭТОМ сервере (подставьте домен и секрет из .env):
#        CRON_SECRET='ваш-длинный-секрет'
#        */15 * * * * curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" "https://ВАШ-ДОМЕН/api/cron/click-auto-pay"
#        10 * * * * curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" "https://ВАШ-ДОМЕН/api/cron/click-fiscal-retry"
#      Для переменной в cron проще один файл ~root/click-cron.sh с export CRON_SECRET=... и вызовами curl.
# 4) Примените миграции Supabase 033–035 (card_tokens, логи, фискализация).
# 5) Колбеки Click должны быть по HTTPS с интернета. Обычно указывают домен (A-запись на IP сервера), не голый IP —
#    Let's Encrypt и некоторые провайдеры EPS лучше работают с именем хоста. В кабинете Click: https://ДОМЕН/api/click/prepare
#    и .../complete на тот же хост, где реально слушает ваш Node (часто за nginx reverse proxy).
# 6) Локально реальные колбеки часто недоступны — тестируйте на прод-сервере с HTTPS по домену.
#
# Публичный URL только для скрипта preflight (печать колбеков); можно не задавать, тогда передайте аргументом CLI.
# CLICK_PUBLIC_BASE_URL="https://www.falarus.uz"
#
# CLICK_SERVICE_ID="your-click-service-id"
# CLICK_MERCHANT_ID="your-click-merchant-id"
# CLICK_MERCHANT_USER_ID — Merchant API Auth hamda Shop/Button forma maydoni merchant_user_id uchun ishlatiladi
# CLICK_SECRET_KEY="your-click-secret-key"
# CLICK_RETURN_URL="https://www.falarus.uz/profile"
# Prodakshen: NODE_ENV=production bo‘lsin (npm run start). MD5 imzo prepare/complete uchun har doim tekshiriladi.
# CLICK_SKIP_SIGNATURE_VERIFY — faqat mahalliy sinovda (NODE_ENV !== production): true bo‘lsa imzo tekshirilmaydi. Prod-da yozmayman / ta’sirsiz.
# Click card_token auto-pay: AES-256-GCM key (32+ chars recommended); fallback hashes JWT_SECRET if unset.
# CLICK_CARD_TOKEN_ENCRYPTION_KEY="..."
# Vercel Cron: set CRON_SECRET in project env; platform sends Authorization: Bearer CRON_SECRET.
# Same value accepted as CLICK_CRON_SECRET for manual triggers.
# CRON_SECRET="..."
# CLICK_CRON_SECRET="..."
# Hourly (Vercel Cron or external): GET|POST /api/cron/click-fiscal-retry with Authorization: Bearer CRON_SECRET
# Retries failed OFD submits (max 4 attempts per payment).

# Click fiscalization (OFД) — POST https://docs.click.uz/en/fiscalization/ — submit_items + fetch qrCodeURL
# Does not block payment success; failures are stored on `payments` and retried by cron.
# CLICK_IKPU_CODE="10899002001000000"
# Package / label code from SolIQ catalogue (required for submit_items):
# CLICK_PACKAGE_CODE=""
# CommissionInfo: legal entity STIR (9) or PINFL (14) per Click docs
# CLICK_FISCAL_COMMISSION_TIN=""
# CLICK_FISCAL_COMMISSION_PINFL=""
# Optional VAT (0–255). Default 0. If above 0, VAT tiyin is calculated as inclusive of Price.
# CLICK_FISCAL_VAT_PERCENT="0"
# CLICK_FISCAL_DISABLED="false"

# Optional: smoke-test settings for deployed API.
# SMOKE_BASE_URL="https://your-project.vercel.app"
# SMOKE_EMAIL="student@example.com"
# SMOKE_PASSWORD="secret"
# or:
# SMOKE_BEARER_TOKEN="..."
