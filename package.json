{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--disable-warning=DEP0169 tsx server.ts",
    "dev:prod": "cross-env VITE_API_URL=https://falarus.uz NODE_OPTIONS=--disable-warning=DEP0169 tsx server.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=DEP0169 tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check:env": "node scripts/check-env.mjs",
    "click:preflight": "node scripts/click-preflight.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:tunnel": "bash scripts/vps-db-tunnel.sh",
    "deploy:vps": "bash scripts/vps-deploy.sh",
    "seed:vocabulary": "tsx server/scripts/seedVocabulary.ts",
    "seed:admin": "tsx server/scripts/seedAdmin.ts",
    "seed:word-swipe": "tsx server/scripts/seedWordSwipeGame.ts",
    "import:patent": "python3 scripts/import_patent_exam.py",
    "generate:patent-hints": "python3 scripts/extract_patent_question_hints.py && tsx scripts/generate_patent_hints.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file server/lib/db-types.ts",
    "test:smoke": "node scripts/smoke-api.mjs",
    "test:smoke:full": "cross-env SMOKE_INCLUDE_LESSONS=1 node scripts/smoke-api.mjs",
    "extract:lesson-tasks": "tsx scripts/extract_lesson_tasks.ts",
    "patch:inventory:lesson1-task1": "tsx scripts/ensure_lesson_one_task_one_inventory.ts",
    "import:lesson-tasks": "tsx scripts/import_lesson_tasks.ts",
    "verify:lesson-task-inventory": "tsx scripts/verify_lesson_task_inventory.ts",
    "generate:kunlik-reading-lexeme-fill": "node scripts/writeKunlikLexemeFallbackExtra.mjs && node --import tsx scripts/offlineGenerate076ReadingLexemeFill.ts",
    "verify": "npm run lint && npm run test && npm run build",
    "mobile:icons": "cd mobile && dart run flutter_launcher_icons",
    "mobile:build:aab": "cd mobile && bash scripts/build-store-release.sh android",
    "mobile:build:ipa": "cd mobile && bash scripts/build-store-release.sh ios",
    "mobile:build:store": "cd mobile && bash scripts/build-store-release.sh all"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "intl-tel-input": "^28.0.2",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.2",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "openai": "^6.34.0",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
